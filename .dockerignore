nuxt-app/**/*.key
nuxt-app/**/*.sqlite*
nuxt-app/**/*.db
nuxt-app/**/*.sql.gz
nuxt-app/**/*.log
nuxt-app/**/private_training
nuxt-app/**/browser_profile
nuxt-app/**/colab_capture
nuxt-app/**/*.jsonl
nuxt-app/**/*secret*.json
nuxt-app/**/*token*.json
nuxt-app/**/credentials*.json
