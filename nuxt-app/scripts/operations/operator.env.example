# Template only. Store actual values in the runner's private secret store, never Git.
# Do not load this file into the web application. All external actions default OFF.
DS_OPS_ENABLE_BACKUP=false
DS_OPS_ENABLE_OFFSITE=false
DS_OPS_ENABLE_MONITOR=false
DS_OPS_ENABLE_TASK_MONITOR=false
DS_OPS_ENABLE_ALERTS=false
DS_OPS_STATE_DIR=/var/lib/discoverystack-ops/state
DS_OPS_BACKUP_DIR=/var/lib/discoverystack-ops/snapshots
DS_OPS_BACKUP_INTERVAL_HOURS=24
DS_BACKUP_DATABASE_URL=
DS_BACKUP_ENCRYPTION_KEY=
DS_BACKUP_SSL_CA=
DS_OPS_ORIGIN=
DS_OPS_EXPECT_COMMIT=
# Independent random 32-byte hex token: same value on runner and application host.
DS_OPS_MONITOR_TOKEN=
DS_OPS_RESEND_API_KEY=
DS_OPS_ALERT_FROM=
DS_OPS_ALERT_TO=
DS_OPS_S3_REGION=
DS_OPS_S3_BUCKET=
DS_OPS_S3_ACCESS_KEY_ID=
DS_OPS_S3_SECRET_ACCESS_KEY=
# Optional: exact https://<32-hex-account>.r2.cloudflarestorage.com (region=auto).
# Without this field the adapter pins the regional AWS S3 endpoint, ignoring ambient overrides.
DS_OPS_S3_ENDPOINT=
