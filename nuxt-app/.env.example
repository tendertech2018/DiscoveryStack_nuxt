# Server-only configuration template. All domains and reference values below are examples.
# Never commit a filled .env. Put production secrets in your hosting service.
NODE_ENV=production
DATABASE_URL=
OWNER_OPEN_ID=
# At least 32 UTF-8 bytes, generated independently of passwords and vault keys.
# NUXT_SESSION_SECRET is the preferred runtime alias; do not set conflicting aliases.
JWT_SECRET=
NUXT_SESSION_SECRET=
# Temporary login now requires explicit opt-in, an existing DB admin identity,
# a distinct 32+ byte password, and the exact HTTPS private origin below.
OWNER_SIMPLE_LOGIN_ENABLED=false
OWNER_SIMPLE_LOGIN_PASSWORD=

# Independent provider vault encryption. New writes use authenticated v2 envelopes.
# Preserve legacy session keys until every existing v1 ciphertext is re-encrypted.
NUXT_PROVIDER_VAULT_KEY=
NUXT_PROVIDER_VAULT_KEY_ID=primary
# Optional JSON object of previous key IDs to secrets, e.g. {"previous":"..."}.
NUXT_PROVIDER_VAULT_PREVIOUS_KEYS_JSON=
# Optional JSON array of old session secrets for read-only v1 recovery.
NUXT_PROVIDER_VAULT_LEGACY_SESSION_SECRETS_JSON=

# Deployment identity must be a real source commit, never a placeholder.
# Render supplies RENDER_GIT_COMMIT. Other hosts can inject this at build/runtime.
NUXT_OPERATIONS_BUILD_COMMIT=
# Bounded read-only DB/schema probe. Values are clamped to 250..5000 ms.
NUXT_OPERATIONS_READINESS_TIMEOUT_MS=2000

# Separate operator environment, not required by the web server.
# The backup CLI never falls back to DATABASE_URL or the session/vault key.
# Use a dedicated read-only DB account, and 64 random hex chars for AES-256-GCM.
DS_BACKUP_DATABASE_URL=
DS_BACKUP_ENCRYPTION_KEY=
DS_BACKUP_SSL_CA=
# Restore drill only: loopback host, scoped non-root user, EMPTY ds_restore_* DB.
DS_RESTORE_DATABASE_URL=

# Governed learning loop (default OFF). Apply reviewed migration 0045 before enabling.
# Crawl uses currently approved source cards plus separate, recorded customer learning consent.
NUXT_LEARNING_LOOP_ENABLED=false
NUXT_LEARNING_CRAWL_ENABLED=false
# Optional exact first-party HTTP before/after evidence. Apply reviewed migration 0047 first.
# Needs separate current source consent and controlled server-rendered article integration.
# Background after-only recovery also needs NUXT_LEARNING_LOOP_ENABLED; this does not enable crawling.
NUXT_LEARNING_LIVE_ACTION_ENABLED=false
# Keep retention cleanup enabled independently if new acquisition/loop processing is paused.
# After collecting live actions, keep this cleanup running even when capture/training is paused.
NUXT_LEARNING_RETENTION_ENABLED=false
# Fit one exact owner-reviewed observational release per tick. Never activates a production model.
NUXT_LEARNING_EFFECT_TRAINING_ENABLED=false
NUXT_CONTENT_OPERATIONS_SCHEDULER_ENABLED=false
NUXT_WEEKLY_CONTENT_APPROVAL_ENABLED=false
NUXT_WEEKLY_CONTENT_TOKEN_KEY=
NUXT_WEEKLY_CONTENT_REVIEW_ORIGIN=
NUXT_WEEKLY_CONTENT_LINE_CHANNEL_SECRET=
NUXT_WEEKLY_CONTENT_LINE_ACCESS_TOKEN=
NUXT_WEEKLY_CONTENT_LINE_BOT_USER_ID=
# Do Alignment manual article workbench. Apply additive migration 0057 first.
# Server-only paired credentials; independent of LINE, v2 ingest and read links.
# Does not enable ML generation, the weekly content service or the global scheduler.
NUXT_ARTICLE_WORKBENCH_ENABLED=false
NUXT_ARTICLE_WORKBENCH_SIGNING_SECRET=
NUXT_ARTICLE_WORKBENCH_TARGET_ID=
NUXT_ARTICLE_WORKBENCH_OWNER_SCOPE_KEY=
NUXT_ARTICLE_WORKBENCH_OWNER_USER_ID=
# Optional alternative to owner password sign-in; preferred request-time aliases.
NUXT_OAUTH_SERVER_URL=
NUXT_OAUTH_PORTAL_URL=
NUXT_OAUTH_APP_ID=
NUXT_DISCOVERY_STACK_OAUTH_ALLOWED_ORIGIN=
# Legacy aliases remain supported; do not give them conflicting values.
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OAUTH_ALLOWED_ORIGIN=

# Your public website and the private Nuxt API/customer portal, exact HTTPS origins.
DISCOVERYSTACK_PUBLIC_SITE_ORIGIN=https://www.example.com
# Nuxt's browser-visible runtime mirror must match the server CORS origin above.
# Docker build defaults do not read the host's runtime-only legacy variable.
NUXT_PUBLIC_DISCOVERY_STACK_PUBLIC_SITE_ORIGIN=https://www.example.com
NUXT_DISCOVERYSTACK_PRIVATE_ORIGIN=https://ops.example.com

# Resend: verify your sender domain in Resend first.
NUXT_MANAGED_SITE_EMAIL_API_KEY=
NUXT_MANAGED_SITE_EMAIL_FROM=DiscoveryStack <notifications@example.com>
# Optional; canonical Resend endpoint is the default.
NUXT_MANAGED_SITE_EMAIL_ENDPOINT=https://api.resend.com/emails
NUXT_MANAGED_SITE_EMAIL_TIMEOUT_MS=10000
NUXT_MANAGED_SITE_EMAIL_CODE_PEPPER=
# Platform transactional email queue. Apply the reviewed outbox migration first.
# Independent random server-only key: 32..4096 bytes; never reuse the API/session key.
NUXT_MANAGED_SITE_EMAIL_OUTBOX_ENCRYPTION_KEY=
# This gates BOTH immediate delivery and scheduled retries. Deploying does not enable email.
NUXT_MANAGED_SITE_EMAIL_OUTBOX_ENABLED=false
# Clear expired encrypted messages even if delivery is paused; enable only after migration.
NUXT_MANAGED_SITE_EMAIL_OUTBOX_RETENTION_ENABLED=false
MANAGED_SITE_EMAIL_OUTBOX_CRON=*/1 * * * *
# Passive Resend lifecycle observations. Apply reviewed migration 0048 before enabling.
# Independent endpoint signing secret supplied by Resend (whsec_...), not the API key.
# Does not enable sending, retries, tracking, or confirmed inbox/reading claims.
NUXT_MANAGED_SITE_EMAIL_EVENTS_ENABLED=false
NUXT_MANAGED_SITE_EMAIL_EVENTS_WEBHOOK_SECRET=
# Owner investigation closure only; apply reviewed migration 0049 before enabling.
# Does not change queue status, resend, reconcile a receipt, or prove inbox delivery.
NUXT_MANAGED_SITE_EMAIL_REVIEW_ENABLED=false

# One OpenAI-compatible provider for content and page editing.
NUXT_LLM_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
NUXT_LLM_API_KEY=
NUXT_LLM_MODEL=qwen-plus
NUXT_CONTENT_DRAFT_PROVIDER=openai_compatible
NUXT_PAGE_EDITOR_AI_PROVIDER=openai_compatible
NUXT_PAGE_EDITOR_PREVIEW_SECRET=
# Enable only after generation/review/publication acceptance on an always-on host.
NUXT_CONTENT_OPERATIONS_SCHEDULER_ENABLED=false

# Customer site forms. Use the private API origin, independent random pepper.
DISCOVERYSTACK_MANAGED_SITE_FORM_INGEST_ORIGIN=https://ops.example.com
NUXT_MANAGED_SITE_FORM_TOKEN_PEPPER=

# R2/S3 immutable artifact vault; replace account ID and bucket.
DISCOVERYSTACK_MANAGED_SITE_VAULT_JSON={"bucket":"discoverystack-managed-sites-prod","region":"auto","prefix":"managed-sites-v1","endpoint":"https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com"}
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Editor image storage is a separate owner-configured, per-project connection.
# This secret is JSON {"accessKeyId":"...","secretAccessKey":"..."}.
# In the Images workspace, enter only the env name DS_MEDIA_S3_CREDENTIAL.
DS_MEDIA_S3_CREDENTIAL=
# Scanner API contract: POST bytes -> {verdict,reasonCode,scannerReference}.
# NUXT_MEDIA_SCANNER_CREDENTIAL_REF contains the name of a secret env, not a token.
NUXT_MEDIA_SCANNER_ENDPOINT=
NUXT_MEDIA_SCANNER_CREDENTIAL_REF=DS_MEDIA_SCANNER_BEARER
DS_MEDIA_SCANNER_BEARER=

# JSON maps opaque references to secrets. Leave empty until configured securely.
# Required references for the setup examples:
# envref:managed-deployment-runtime -> independent random deployment credential
# envref:managed-dns-tls-hmac -> independent random DNS HMAC credential
# envref:cloudflare-pages-access -> Cloudflare API token
# envref:llm-runtime -> chosen AI API key
# envref:stripe-runtime -> Stripe test API key initially
# envref:stripe-webhook -> separate Stripe endpoint signing secret
# envref:porkbun-runtime -> JSON string with {"apiKey":"...","secretApiKey":"..."}
DISCOVERYSTACK_MANAGED_SITE_CREDENTIALS_JSON=
DISCOVERYSTACK_MANAGED_SITE_INTERNAL_BROKER_JSON={"deploymentCredentialReference":"envref:managed-deployment-runtime","dnsTlsCredentialReference":"envref:managed-dns-tls-hmac","cloudflare":{"accountId":"0123456789abcdef0123456789abcdef","apiTokenReference":"envref:cloudflare-pages-access","projectPrefix":"ds"}}
DISCOVERYSTACK_MANAGED_SITE_ALLOWED_PROVIDER_ORIGINS=https://api.resend.com,https://api.stripe.com,https://api.porkbun.com,https://managed-sites-broker.discoverystack.dev
DISCOVERYSTACK_MANAGED_SITE_ALLOWED_CHECKOUT_ORIGINS=https://checkout.stripe.com
DISCOVERYSTACK_PAYMENT_WEBHOOK_PROVIDER_KEY=stripe
DISCOVERYSTACK_PAYMENT_WEBHOOK_CREDENTIAL_REF=envref:stripe-webhook

# Start with test payments. Test payment never authorizes real domain purchase.
MANAGED_SITE_FUNNEL_STRIPE_LIVE_MODE=false
MANAGED_SITE_FUNNEL_DAILY_BUILD_LIMIT=20
# Per-TLD budget must be selected by the owner; {} intentionally keeps purchasing closed.
MANAGED_SITE_FUNNEL_DOMAIN_PROCUREMENT_POLICY_JSON={}

# Optional measurement: configure read-only GA4/GSC connections in the workbench.
NUXT_GOOGLE_SERVICE_ACCOUNT_JSON=
# Automatic model training stays disabled until data/consent/evaluation gates pass.
NUXT_MODEL_IMPROVEMENT_AUTO_TRAIN=false
