# Inject securely at runtime. Never put these into generated HTML or commit values.
SITE_CONFIG_PATH=./site.config.json
SITE_ORIGIN=https://your-customer-domain.invalid
SITE_DATABASE_PATH=./data/site.sqlite
SITE_UPLOADS_PATH=./data/uploads
HOST=127.0.0.1
PORT=3002
SITE_ADMIN_PASSWORD=
SITE_SESSION_SECRET=
# Customer merchant keys only. Never use the platform subscription Stripe account.
# For stripe_test use sk_test_... and its dedicated endpoint signing secret.
# Webhook endpoint: /api/payments/stripe/webhook (raw signed Stripe events only).
SITE_STRIPE_SECRET_KEY=
SITE_STRIPE_WEBHOOK_SECRET=
SITE_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
